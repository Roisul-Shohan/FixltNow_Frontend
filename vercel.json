{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd fixitnow-frontend && npm install --no-audit --no-fund && npm run build",
  "installCommand": "cd fixitnow-frontend && npm install --no-audit --no-fund",
  "outputDirectory": "fixitnow-frontend/.next",
  "framework": "nextjs",
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}