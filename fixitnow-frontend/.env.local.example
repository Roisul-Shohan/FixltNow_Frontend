# Public env vars exposed to the browser. Anything prefixed NEXT_PUBLIC_* is
# inlined at build time, so change it BEFORE `next build` / Vercel deploy.
#
# Production: leave unset — src/lib/api.ts falls back to the deployed backend.
# Local dev:  point at http://localhost:5000/api (the Express backend in
#             ../FixltNow-Backend) to test against your local API.

NEXT_PUBLIC_API_BASE=https://fixlit-now.vercel.app/api
